# Copy this to .streamlit/secrets.toml for local use, or paste the lines into the "Secrets" box when you
# deploy on Streamlit Community Cloud. NEVER commit the real secrets.toml (it is in .gitignore).
# Every setting is optional.

# Visitors must enter this code before they can see the sign-in screen. Share it only with the mentor.
FO_ACCESS_CODE = "choose-a-code-to-share-with-the-mentor"

# Cap on self-registered accounts (demo families do not count). Default is 200.
FO_MAX_ACCOUNTS = "100"
