# Reference list of every setting. Every variable is optional; with none set, the app runs locally with safe defaults.
#
# IMPORTANT: nothing reads a ".env" file by itself. The API and the Streamlit app read real environment variables only
# (the Streamlit app also reads .streamlit/secrets.toml). Set them in the shell that starts the server, for example:
#     PowerShell:   $env:FO_API_DOCS = "0"; .\.venv\Scripts\python.exe -m uvicorn api.main:app --port 8100
#     bash:         FO_API_DOCS=0 python -m uvicorn api.main:app --port 8100
# On a host, use its environment-variable settings. The one exception is the web dev server, which also reads FO_* names
# from web/.env.local. Never put a real secret in this file or commit a filled-in copy (.env and .env.* are git-ignored).
# Full descriptions: docs/configuration.md

# --- Shared by the Streamlit app and the API --------------------------------------------------------------
# FO_DB_PATH=data/app.db
# FO_MAX_ACCOUNTS=200

# --- Streamlit app only -----------------------------------------------------------------------------------
# FO_ACCESS_CODE=choose-a-long-random-phrase

# --- API (FastAPI) ----------------------------------------------------------------------------------------
# FO_API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# FO_API_COOKIE_SECURE=0          # set to 1 whenever the site is served over HTTPS
# FO_API_SESSION_HOURS=12
# FO_API_DEMO_LOGIN=1             # set to 0 for any pilot that holds real data
# FO_API_DEMO_HOURS=24
# FO_API_MAX_PROFILES=25
# FO_API_MAX_BODY_KB=256
# FO_API_ANALYSIS_TIMEOUT=90
# FO_API_DOCS=1                   # set to 0 to hide /docs and /openapi.json when hosted

# --- Assistant's question router (optional local model) ---------------------------------------------------
# FO_EMBED=1                      # set to 0 to ignore the model even if its files are present (word matching only)
# FO_EMBED_DIR=data/models        # folder tools/fetch_embedding_model.py filled; the server never downloads anything itself

# --- Web dev server and preview (web/, read by vite.config.ts; also from web/.env.local) -----------------
# FO_API_URL=http://127.0.0.1:8100   # where /api is proxied to
