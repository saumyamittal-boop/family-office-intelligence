# Copy to .env for local use and fill in. Never commit the real file (it is git-ignored).
# Every variable is optional; with none set, the app runs locally with safe defaults.

# --- Shared by the Streamlit app and the API --------------------------------------------------------------
# FO_DB_PATH=data/app.db
# FO_MAX_ACCOUNTS=200

# --- Streamlit app only -----------------------------------------------------------------------------------
# FO_ACCESS_CODE=choose-a-long-random-phrase

# --- API (FastAPI) ----------------------------------------------------------------------------------------
# FO_API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# FO_API_COOKIE_SECURE=0          # set to 1 whenever the site is served over HTTPS
# FO_API_SESSION_HOURS=12
# FO_API_DEMO_LOGIN=1             # set to 0 for any pilot that holds real data
# FO_API_DEMO_HOURS=24
# FO_API_MAX_PROFILES=25
# FO_API_MAX_BODY_KB=256
# FO_API_ANALYSIS_TIMEOUT=90
# FO_API_DOCS=1                   # set to 0 to hide /docs and /openapi.json when hosted
