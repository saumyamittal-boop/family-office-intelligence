# Keep LF line endings in the repository and in working copies, so Docker and Linux hosts get exactly what
# was written (a CRLF Dockerfile or script can fail on Linux).
* text=auto eol=lf

Dockerfile text eol=lf
.dockerignore text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
*.py text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.txt text eol=lf
*.example text eol=lf

# Never touch the local database
*.db binary
